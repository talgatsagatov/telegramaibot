# Скопируйте этот файл в `.env` и заполните реальными значениями.
# НИКОГДА не коммитьте файл `.env` в git.

# Токен Telegram-бота (получить у @BotFather)
BOT_TOKEN=

# API-ключ OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Telegram chat_id администратора, куда приходят уведомления о заявках.
# Узнать свой ID можно через бота @userinfobot или @getmyid_bot.
ADMIN_CHAT_ID=

# Модель OpenRouter. Формат: provider/model-name
# Примеры:
#   openai/gpt-4o-mini        — дешевле всего, быстро
#   openai/gpt-4o             — мощнее, дороже
#   anthropic/claude-haiku-4-5 — альтернатива
# Полный список: https://openrouter.ai/models
OPENROUTER_MODEL=openai/gpt-4o-mini

# Название маркетингового агентства (подставляется в приветствие и системный промпт ИИ).
AGENCY_NAME=Marketing Pro

# Путь к файлу БД SQLite (создаётся автоматически при первом запуске).
DATABASE_URL=sqlite+aiosqlite:///bot.db

# Уровень логирования: DEBUG / INFO / WARNING / ERROR.
LOG_LEVEL=INFO
